# DeepSeek API Key (必需)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# DeepSeek 模型 (可选，默认 deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 前端访问令牌 (生产环境必须设置，防止 API 被外部滥用)
# 设置后前端需要在请求头带上 X-Access-Token
ACCESS_TOKEN=redwriter-v1-your-secret-token

# IP 限流 (每 IP 每分钟最大请求数，默认 30)
RATE_LIMIT=30

# JWT 密钥
SECRET_KEY=change-me-to-a-random-string
